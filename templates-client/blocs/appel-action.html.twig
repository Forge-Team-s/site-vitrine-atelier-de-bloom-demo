{# ─────────────────────────────────────────────────────────────────────────
   APPEL À L'ACTION — l'invitation posée en fin de page.

   Propre à ce site. Ses champs réutilisent ceux du bandeau — texte, image,
   description et bouton — dont les conditions ont été élargies à ce type
   dans cockpit/models/pages.model.php ; seul le second bouton lui est propre.

   L'illustration passe par partials/image.html.twig comme partout ailleurs :
   posée en fond par le CSS, elle n'aurait pas de description et ne serait
   chargée qu'après la feuille de style.
   ───────────────────────────────────────────────────────────────────────── #}

{# Sans illustration, le bandeau occupe toute sa largeur plutôt que de laisser
   une colonne vide : la classe le dit au CSS, qui ne peut pas le deviner. #}
<section class="bloc bloc-appel-action{% if not bloc.image %} bloc-appel-action--sans-image{% endif %}">

    {% if bloc.image %}
        {% include 'partials/image.html.twig' with {
            asset: bloc.image,
            alt: bloc.alt,
            classe: 'bloc-appel-action__image',
            sizes: '(min-width: 48rem) 22rem, 100vw',
            eager: premier
        } only %}
    {% endif %}

    <div class="bloc-appel-action__texte">

        {% if titre %}
            <h{{ niveau }} class="bloc-appel-action__titre">{{ titre }}</h{{ niveau }}>
        {% endif %}

        {% if bloc.texte %}
            {# Texte enrichi produit par l'éditeur de l'administration :
               volontairement non échappé, comme dans les sections livrées. #}
            {{ bloc.texte|raw }}
        {% endif %}

        {% if bloc.boutonTexte and bloc.boutonLien or bloc.boutonSecondaireTexte and bloc.boutonSecondaireLien %}
            <p class="bloc-appel-action__boutons">
                {% if bloc.boutonTexte and bloc.boutonLien %}
                    <a class="bouton" href="{{ bloc.boutonLien }}">{{ bloc.boutonTexte }}</a>
                {% endif %}

                {% if bloc.boutonSecondaireTexte and bloc.boutonSecondaireLien %}
                    <a class="bouton bouton--discret" href="{{ bloc.boutonSecondaireLien }}">{{ bloc.boutonSecondaireTexte }}</a>
                {% endif %}
            </p>
        {% endif %}

    </div>

</section>
